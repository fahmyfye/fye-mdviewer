#!/usr/bin/env python3
"""
mdview — local Markdown viewer/editor.

  mdview notes.md

Opens a browser tab served from 127.0.0.1 on a random port. Default is a
read-only rendered view; the "Edit" toggle opens a split editor with live
preview and in-place Save (writes back to the original file). Fully offline —
all JS/CSS is served from ~/.local/share/mdview. The server shuts itself down
a few seconds after the tab is closed.
"""

import http.server
import json
import mimetypes
import os
import socketserver
import sys
import threading
import time
import urllib.parse
import webbrowser
from pathlib import Path

ASSETS = (Path.home() / ".local/share/mdview").resolve()
REQUIRED_ASSETS = [
    "app.html",
    "marked.min.js",
    "highlight.min.js",
    "github-markdown.css",
    "hljs-github.css",
    "hljs-github-dark.css",
    "mermaid.min.js",
    "katex/katex.min.css",
    "katex/katex.min.js",
    "katex/auto-render.min.js",
]
CONTENT_TYPES = {
    ".js": "text/javascript",
    ".css": "text/css",
    ".woff2": "font/woff2",
    ".woff": "font/woff",
    ".ttf": "font/ttf",
    ".html": "text/html",
    ".json": "application/json",
}
IDLE_TIMEOUT = 12  # seconds without a request from the tab -> exit
START_GRACE = 20   # seconds to allow for the browser to make its first request


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


if len(sys.argv) < 2:
    die("Usage: mdview <file.md>")

SRC = Path(sys.argv[1]).expanduser()
try:
    SRC = SRC.resolve(strict=True)
except FileNotFoundError:
    die(f"No such file: {SRC}")
if not SRC.is_file():
    die(f"Not a file: {SRC}")

for name in REQUIRED_ASSETS:
    if not (ASSETS / name).is_file():
        die(f"Missing asset: {ASSETS / name}\nRe-run install.sh to restore it.")

_last_seen = time.time()
_lock = threading.Lock()


def touch():
    global _last_seen
    with _lock:
        _last_seen = time.time()


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def _send(self, code, body, ctype="text/plain; charset=utf-8"):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            self.wfile.write(body)
        except BrokenPipeError:
            pass

    def do_GET(self):
        touch()
        path = urllib.parse.urlparse(self.path).path

        if path == "/":
            return self._send(200, (ASSETS / "app.html").read_bytes(),
                              "text/html; charset=utf-8")
        if path == "/ping":
            return self._send(200, "ok")
        if path == "/meta":
            return self._send(200, json.dumps({"name": SRC.name, "path": str(SRC)}),
                              "application/json")
        if path == "/raw":
            try:
                return self._send(200, SRC.read_text(encoding="utf-8"))
            except Exception as exc:
                return self._send(500, str(exc))
        if path.startswith("/assets/"):
            rel = urllib.parse.unquote(path[len("/assets/"):])
            target = (ASSETS / rel).resolve()
            if ASSETS in target.parents and target.is_file():
                ext = target.suffix.lower()
                ctype = CONTENT_TYPES.get(ext) or mimetypes.guess_type(str(target))[0] \
                    or "application/octet-stream"
                if ctype.startswith(("text/", "application/json")):
                    ctype += "; charset=utf-8"
                return self._send(200, target.read_bytes(), ctype)
        return self._send(404, "not found")

    def do_PUT(self):
        touch()
        path = urllib.parse.urlparse(self.path).path
        if path != "/raw":
            return self._send(404, "not found")
        length = int(self.headers.get("Content-Length", 0))
        data = self.rfile.read(length).decode("utf-8")
        try:
            tmp = SRC.with_name(SRC.name + ".mdview.tmp")
            tmp.write_text(data, encoding="utf-8")
            os.replace(tmp, SRC)  # atomic in-place save
            return self._send(200, "saved")
        except Exception as exc:
            return self._send(500, str(exc))


def watchdog():
    time.sleep(START_GRACE)
    while True:
        time.sleep(3)
        with _lock:
            idle = time.time() - _last_seen
        if idle > IDLE_TIMEOUT:
            os._exit(0)


def main():
    httpd = socketserver.ThreadingTCPServer(("127.0.0.1", 0), Handler)
    httpd.daemon_threads = True
    port = httpd.server_address[1]
    url = f"http://127.0.0.1:{port}/"

    threading.Thread(target=watchdog, daemon=True).start()
    print(f"mdview  {SRC.name}  →  {url}  (Ctrl+C to stop)")
    webbrowser.open(url)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
